{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tindomiel",
  "version": "0.1.0",
  "identifier": "com.tindomiel.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web && npm run build:server"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tindomiel",
        "url": "index.html",
        "create": false,
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "resources/tindomiel-server": "./"
    }
  }
}
